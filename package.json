{
  "name": "bash-command-mcp",
  "version": "0.1.6",
  "description": "Sophisticated bash command MCP server that runs and manages shell execution.",
  "license": "MIT",
  "homepage": "https://github.com/mrorigo/bash-command-mcp#readme",
  "bugs": {
    "url": "https://github.com/mrorigo/bash-command-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrorigo/bash-command-mcp.git"
  },
  "main": "./dist/index.js",
  "bin": {
    "bash-command-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "Dockerfile",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bash",
    "cli",
    "stdio",
    "http",
    "streamable-http",
    "server"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "start": "bun dist/index.js",
    "dev": "bun run --watch index.ts",
    "lint:ox": "oxlint -D typescript/no-explicit-any .",
    "lint:eslint": "eslint .",
    "lint": "bun run lint:ox && bun run lint:eslint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run lint && bun run typecheck",
    "prepublishOnly": "bun run check && bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.mrorigo/bash-command-mcp",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "eslint": "^10.1.0",
    "eslint-plugin-jsdoc": "^62.8.1",
    "globals": "^17.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.57.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "oxlint": "^1.48.0",
    "zod": "^4.3.6"
  }
}
